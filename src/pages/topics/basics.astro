---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {publishedArticles} from '../../lib/content';
import {site} from '../../data/site';
const articles=await publishedArticles();
---
<Base title={"Google Play"} description={site.keyword+' '+"Google Play 결제·잔액·개별 주문 환불을 분리해 원하는 처리 경로를 찾습니다."} crumbs={[{name:"Google Play",url:"/topics/basics/"}]}><div class="page-intro"><p class="eyebrow">READING INDEX</p><h1>Google Play</h1><p>{site.intro}</p></div><section><h2>이 주제에서 확인할 가이드</h2><div class="articles-grid">{articles.map(article=><ArticleCard article={article}/>)}</div><p><a href="/guide/">확인 질문을 정리하는 순서</a> · <a href="/topics/basics/">주제의 범위</a> · <a href="/about/">편집 원칙</a></p></section></Base>